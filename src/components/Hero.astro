---
import type { Lang } from '../i18n/utils';
import { getTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i18n = getTranslations(lang);
---

<section class="hero" id="hero">
  <!-- Field lines background decoration -->
  <div class="field-lines" aria-hidden="true">
    <div class="field-circle"></div>
    <div class="field-line-h"></div>
    <div class="field-corner fl-tl"></div>
    <div class="field-corner fl-tr"></div>
  </div>

  <!-- Scan lines overlay -->
  <div class="scanlines" aria-hidden="true"></div>

  <div class="container hero-inner">
    <!-- LEFT: Content -->
    <div class="hero-content">
      <!-- LIVE badge -->
      <div class="hero-badge reveal">
        <span class="live-dot"></span>
        <span class="live-text">LIVE</span>
        {lang === 'es' ? 'Disponible para proyectos' : 'Available for projects'}
      </div>

      <!-- Name display - jersey style -->
      <div class="hero-identity reveal">
        <span class="jersey-number" aria-hidden="true">17</span>
        <div class="hero-name-block">
          <span class="hero-firstname glitch" data-text="ESTEBAN">ESTEBAN</span>
          <span class="hero-lastname">CASTRO</span>
        </div>
      </div>

      <!-- Headline -->
      <h1 class="hero-headline reveal">
        {i18n.hero.headline}
      </h1>

      <!-- Description -->
      <p class="hero-description reveal">
        {i18n.hero.description}
      </p>

      <!-- Passion tags -->
      <div class="hero-passions reveal" aria-label="Pasiones">
        <span class="passion-tag football">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"/>
            <path d="M12 2 L14 8 L20 8 L15 12 L17 18 L12 14 L7 18 L9 12 L4 8 L10 8 Z" fill="currentColor" opacity="0.6"/>
          </svg>
          {lang === 'es' ? 'Fútbol' : 'Football'}
        </span>
        <span class="passion-tag gaming">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="6" width="20" height="12" rx="2"/>
            <path d="M6 10 L6 14 M4 12 L8 12"/>
            <circle cx="16" cy="10" r="1" fill="currentColor"/>
            <circle cx="18" cy="12" r="1" fill="currentColor"/>
          </svg>
          Gaming
        </span>
        <span class="passion-tag tech">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="16 18 22 12 16 6"/>
            <polyline points="8 6 2 12 8 18"/>
          </svg>
          Tech
        </span>
      </div>

      <!-- Stats row -->
      <!-- <div class="hero-stats reveal">
        <div class="stat-item">
          <span class="stat-num" data-target="6">0</span>
          <span class="stat-plus">+</span>
          <span class="stat-label">{lang === 'es' ? 'Años exp.' : 'Years exp.'}</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num" data-target="15">0</span>
          <span class="stat-plus">+</span>
          <span class="stat-label">{lang === 'es' ? 'Proyectos' : 'Projects'}</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num" data-target="500">0</span>
          <span class="stat-plus">h</span>
          <span class="stat-label">{lang === 'es' ? 'Automatizadas' : 'Automated'}</span>
        </div>
      </div> -->

      <!-- CTAs -->
      <div class="hero-cta reveal">
        <a href="#projects" class="btn btn-primary">
          {i18n.hero.cta_projects}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <a href="#contact" class="btn btn-secondary">
          {i18n.hero.cta_contact}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- RIGHT: Visual terminal -->
    <div class="hero-visual" aria-hidden="true">
      <!-- Orbs -->
      <div class="hero-orb hero-orb-red"></div>
      <div class="hero-orb hero-orb-blue"></div>

      <!-- Terminal window -->
      <div class="hero-terminal reveal">
        <div class="terminal-header">
          <div class="terminal-dots">
            <span style="background: #FF5F57"></span>
            <span style="background: #FEBC2E"></span>
            <span style="background: #28C840"></span>
          </div>
          <span class="terminal-title">esteban.config.ts</span>
          <span class="terminal-status">● active</span>
        </div>
        <div class="terminal-body">
          <pre><code><span class="t-keyword">const</span> <span class="t-var">esteban</span> = {`{`}
  <span class="t-comment">// ⚽ Fiel al DIM desde siempre</span>
  <span class="t-prop">team</span>:       <span class="t-string">'Independiente Medellín'</span>,
  <span class="t-prop">jersey</span>:     <span class="t-number">17</span>,

  <span class="t-comment">// 🎮 Level 99 Developer</span>
  <span class="t-prop">stack</span>:      [<span class="t-string">'React'</span>, <span class="t-string">'Astro'</span>, <span class="t-string">'n8n'</span>],
  <span class="t-prop">xp</span>:         <span class="t-number">6</span> <span class="t-keyword">+</span> <span class="t-string">'years'</span>,

  <span class="t-comment">// 💻 Siempre en producción</span>
  <span class="t-prop">status</span>:     <span class="t-string">'building'</span>,
  <span class="t-prop">passion</span>:    <span class="t-string">'impact'</span>,
{`}`};</code></pre>
          <div class="terminal-cursor"></div>
        </div>
      </div>

      <!-- Achievement card -->
      <div class="achievement-card reveal">
        <div class="achievement-icon">🏆</div>
        <div class="achievement-text">
          <span class="achievement-label">{lang === 'es' ? 'LOGRO DESBLOQUEADO' : 'ACHIEVEMENT UNLOCKED'}</span>
          <span class="achievement-title">{lang === 'es' ? 'Frontend Developer' : 'Frontend Developer'}</span>
        </div>
      </div>
    </div>
  </div>


</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding-top: 80px;
    overflow: hidden;
  }

  /* === FIELD LINES === */
  .field-lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .field-circle {
    position: absolute;
    top: 50%;
    right: -5%;
    width: 500px;
    height: 500px;
    border: 1px solid rgba(200, 16, 46, 0.06);
    border-radius: 50%;
    transform: translateY(-50%);
  }

  .field-line-h {
    position: absolute;
    top: 50%;
    right: -5%;
    width: 500px;
    height: 1px;
    background: rgba(200, 16, 46, 0.06);
    transform: translateY(-50%);
  }

  .field-corner {
    position: absolute;
    width: 80px;
    height: 80px;
    border: 1px solid rgba(29, 78, 216, 0.08);
    border-radius: 0 0 0 80px;
  }

  .fl-tl {
    top: 80px;
    left: 0;
    border-top: none;
    border-right: none;
    border-radius: 0 0 80px 0;
    transform: none;
    border-color: rgba(200, 16, 46, 0.06);
  }

  .fl-tr {
    display: none;
  }

  /* === SCANLINES === */
  .scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.015) 2px,
      rgba(0, 0, 0, 0.015) 4px
    );
    z-index: 1;
  }

  /* === LAYOUT === */
  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 64px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-content {
    position: relative;
  }

  /* === LIVE BADGE === */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 10px;
    border: 1px solid var(--border-red);
    border-radius: 3px;
    font-size: 0.8rem;
    font-family: var(--font-heading);
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    margin-bottom: 24px;
    background: var(--crimson-subtle);
    text-transform: uppercase;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background: var(--green);
    border-radius: 50%;
    animation: livePulse 1.5s ease-in-out infinite;
    flex-shrink: 0;
  }

  .live-text {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--crimson);
    letter-spacing: 0.1em;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 var(--crimson-glow); }
    50% { opacity: 0.5; box-shadow: 0 0 0 6px transparent; }
  }

  /* === IDENTITY / JERSEY NAME === */
  .hero-identity {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .jersey-number {
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 7rem);
    line-height: 1;
    color: var(--crimson);
    opacity: 0.15;
    user-select: none;
    position: relative;
    top: -4px;
  }

  .hero-name-block {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hero-firstname {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 0.9;
    color: var(--text-primary);
    letter-spacing: 0.05em;
    position: relative;
  }

  .hero-lastname {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 0.9;
    letter-spacing: 0.05em;
    background: linear-gradient(90deg, var(--crimson) 0%, var(--cobalt-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Glitch effect */
  .glitch {
    position: relative;
  }

  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-display);
    font-size: inherit;
    letter-spacing: inherit;
    line-height: inherit;
  }

  .glitch::before {
    color: var(--crimson);
    animation: glitchTop 4s infinite;
    clip-path: polygon(0 0, 100% 0, 100% 35%, 0 35%);
    -webkit-clip-path: polygon(0 0, 100% 0, 100% 35%, 0 35%);
  }

  .glitch::after {
    color: var(--cobalt-light);
    animation: glitchBottom 4s infinite;
    clip-path: polygon(0 65%, 100% 65%, 100% 100%, 0 100%);
    -webkit-clip-path: polygon(0 65%, 100% 65%, 100% 100%, 0 100%);
  }

  @keyframes glitchTop {
    0%, 90%, 100% { transform: translate(0); opacity: 0; }
    92% { transform: translate(-2px, -1px); opacity: 0.8; }
    94% { transform: translate(2px, 1px); opacity: 0; }
    96% { transform: translate(-1px, 0); opacity: 0.6; }
    98% { transform: translate(0); opacity: 0; }
  }

  @keyframes glitchBottom {
    0%, 90%, 100% { transform: translate(0); opacity: 0; }
    93% { transform: translate(2px, 1px); opacity: 0.8; }
    95% { transform: translate(-2px, -1px); opacity: 0; }
    97% { transform: translate(1px, 0); opacity: 0.5; }
    99% { transform: translate(0); opacity: 0; }
  }

  /* === HEADLINE === */
  .hero-headline {
    font-family: var(--font-heading);
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 500;
    line-height: 1.5;
    margin-bottom: 16px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-left: 3px solid var(--crimson);
    padding-left: 14px;
  }

  /* === DESCRIPTION === */
  .hero-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 24px;
    max-width: 520px;
  }

  /* === PASSION TAGS === */
  .hero-passions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .passion-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 2px;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: all var(--transition);
  }

  .passion-tag.football {
    background: var(--crimson-subtle);
    border: 1px solid var(--border-red);
    color: var(--crimson-light);
  }

  .passion-tag.gaming {
    background: rgba(245, 158, 11, 0.07);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: var(--gold);
  }

  .passion-tag.tech {
    background: var(--cobalt-subtle);
    border: 1px solid var(--border-blue);
    color: var(--cobalt-light);
  }

  .passion-tag:hover {
    transform: translateY(-2px);
  }

  /* === STATS === */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 36px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    width: fit-content;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px 28px;
    gap: 2px;
    position: relative;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border);
    flex-shrink: 0;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--crimson-light);
  }

  .stat-plus {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--crimson);
    position: absolute;
    top: 14px;
    margin-left: 2px;
    left: 30px;
  }

  @media screen and (max-width: 648px){
    .stat-plus{
      left: 20px;
    }
  }
  .stat-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* === CTA === */
  .hero-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* === VISUAL SIDE === */
  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    gap: 16px;
    min-height: 420px;
  }

  

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
  }

  .hero-orb-red {
    width: 280px;
    height: 280px;
    background: var(--crimson);
    opacity: 0.12;
    top: 5%;
    right: -5%;
    animation: floatOrb 8s ease-in-out infinite;
  }

  .hero-orb-blue {
    width: 220px;
    height: 220px;
    background: var(--cobalt-light);
    opacity: 0.12;
    bottom: 10%;
    left: -5%;
    animation: floatOrb 6s ease-in-out infinite reverse;
  }

  @keyframes floatOrb {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(15px, -20px) scale(1.05); }
    66% { transform: translate(-10px, 10px) scale(0.96); }
  }

  /* === TERMINAL === */
  .hero-terminal {
    position: relative;
    background: #08080F;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    z-index: 1;
    border-top: 2px solid var(--crimson);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border);
  }

  .terminal-dots {
    display: flex;
    gap: 5px;
  }

  .terminal-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: block;
  }

  .terminal-title {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-align: center;
  }

  .terminal-status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #28C840;
  }

  .terminal-body {
    padding: 20px 24px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.85;
    position: relative;
    overflow: hidden;
  }

  .terminal-cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: var(--crimson);
    vertical-align: middle;
    margin-left: 2px;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .t-keyword { color: #F472B6; }
  .t-var { color: #FB923C; }
  .t-prop { color: var(--cobalt-light); }
  .t-string { color: #4ADE80; }
  .t-number { color: var(--gold); }
  .t-comment { color: var(--text-muted); font-style: italic; }

  /* === ACHIEVEMENT CARD === */
  .achievement-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(245, 158, 11, 0.06);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: var(--radius-md);
    padding: 14px 18px;
    z-index: 1;
    position: relative;
    animation: achievementGlow 3s ease-in-out infinite;
  }

  @keyframes achievementGlow {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    50% { box-shadow: 0 0 20px rgba(245, 158, 11, 0.15); }
  }

  .achievement-icon {
    font-size: 2rem;
    filter: drop-shadow(0 0 8px var(--gold-glow));
    animation: spin3D 6s ease-in-out infinite;
  }

  @keyframes spin3D {
    0%, 100% { transform: rotateY(0deg); }
    50% { transform: rotateY(180deg); }
  }

  .achievement-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .achievement-label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--gold);
    text-transform: uppercase;
  }

  .achievement-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  @keyframes scrollDown {
    0% { top: -50%; }
    100% { top: 150%; }
  }

  /* === RESPONSIVE === */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 48px;
      text-align: center;
    }

    .hero-identity {
      justify-content: center;
    }

    .hero-description {
      max-width: 100%;
    }

    .hero-passions {
      justify-content: center;
    }

    .hero-stats {
      margin: 0 auto 36px;
    }

    .hero-cta {
      justify-content: center;
    }

    .hero-visual {
      min-height: auto;
    }

    .hero-orb-red,
    .hero-orb-blue {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-badge {
      font-size: 0.72rem;
    }

    .hero-firstname,
    .hero-lastname {
      font-size: clamp(2.2rem, 10vw, 3.5rem);
    }

    .jersey-number {
      font-size: 3.5rem;
    }

    .stat-item {
      padding: 12px 16px;
    }

    .terminal-body {
      font-size: 0.75rem;
      padding: 16px;
    }
  }

  @media screen and (max-width: 648px){
    .achievement-card{
      display: none!important;
    }
  }

</style>
