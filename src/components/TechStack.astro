---
import type { Lang } from '../i18n/utils';
import { getTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i18n = getTranslations(lang);
const stack = i18n.stack;

const categories = [
  {
    name: stack.frontend,
    techs: [
      { name: 'Next.js', color: '#FFFFFF' },
      { name: 'Astro', color: '#FF5D01' },
      { name: 'React', color: '#61DAFB' },
      { name: 'TypeScript', color: '#3178C6' },
      { name: 'JavaScript', color: '#F7DF1E' },
      { name: 'HTML5', color: '#E34F26' },
      { name: 'CSS3', color: '#1572B6' },
      { name: 'GSAP', color: '#88CE02' },
    ],
  },
  {
    name: stack.backend,
    techs: [
      { name: 'Python', color: '#3776AB' },
      { name: 'FastAPI', color: '#009688' },
      { name: 'Node.js', color: '#339933' },
      { name: 'Express', color: '#ffffff' },
      { name: 'REST APIs', color: '#C8102E' },
      { name: 'PostgreSQL', color: '#4169E1' },
      { name: 'Prisma', color: '#5A67D8' },
      { name: 'MySQL', color: '#4479A1' },
      { name: 'Supabase', color: '#3ECF8E' },
    ],
  },
  {
    name: stack.automation,
    techs: [
      { name: 'n8n', color: '#EA4B71' },
      { name: 'Power Automate', color: '#0066FF' },
      { name: 'Rocketbot', color: '#FF6B35' },
      { name: 'Web Crawlers', color: '#14B8A6' },
      { name: 'SEO Workflows', color: '#F59E0B' },
    ],
  },
  {
    name: stack.ai,
    techs: [
      { name: 'RAG', color: '#8B5CF6' },
      { name: 'Claude API', color: '#D97757' },
      { name: 'LLMs', color: '#00A67E' },
      { name: 'Embeddings', color: '#0EA5E9' },
      { name: 'sentence-transformers', color: '#EE4C2C' },
      { name: 'ChromaDB', color: '#F59E0B' },
      { name: 'Semantic Search', color: '#14B8A6' },
      { name: 'Whisper', color: '#10B981' },
      { name: 'Agentic AI', color: '#F472B6' },
      { name: 'Prompt Engineering', color: '#FB923C' },
      { name: 'NLP', color: '#6366F1' },
    ],
  },
  {
    name: stack.cms,
    techs: [
      { name: 'WordPress', color: '#21759B' },
      { name: 'WooCommerce', color: '#96588A' },
      { name: 'Shopify', color: '#96BF48' },
      { name: 'VTEX', color: '#E31C3D' },
      { name: 'WordPress Headless', color: '#0F766E' },
    ],
  },
];
---

<section class="section" id="stack">
  <div class="container">
    <h2 class="section-title reveal">{stack.title}</h2>
    <div class="stack-categories">
      {categories.map((cat) => (
        <div class="stack-category reveal">
          <h3 class="category-name">{cat.name}</h3>
          <div class="tech-grid">
            {cat.techs.map((tech) => (
              <div class="tech-item" style={`--tech-color: ${tech.color}`}>
                <span class="tech-dot"></span>
                <span class="tech-name">{tech.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stack-categories {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-top: 48px;
  }

  .category-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--crimson);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 400;
    margin-bottom: 20px;
  }

  .tech-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: all var(--transition);
    cursor: default;
  }

  .tech-item:hover {
    border-color: var(--tech-color);
    box-shadow: 0 0 20px color-mix(in srgb, var(--tech-color) 20%, transparent);
    transform: translateY(-2px);
  }

  .tech-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tech-color);
    flex-shrink: 0;
  }

  .tech-name {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .tech-grid {
      gap: 8px;
    }

    .tech-item {
      padding: 10px 16px;
      font-size: 0.85rem;
    }
  }
</style>
