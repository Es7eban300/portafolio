---
import type { Lang } from '../i18n/utils';
import { getTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

interface Project {
  title: string;
  description: string;
  domain: string;
  problem: string;
  solution: string;
  results: string;
  tech: string;
  link?: string;
  image?: string;
  gallery?: string[];
}

const { lang } = Astro.props;
const i18n = getTranslations(lang);
const p = i18n.projects;

const projects: Project[] = [
  p.project1,
  p.project2,
  p.project3,
  p.project4,
  p.project5,
  p.project6,
  p.project7,
  p.project8,
  p.project9,
  p.project10,
].filter((project): project is Project => Boolean(project));

const getProjectLink = (project: Project): string | undefined => {
  if (project.link) return project.link;
  if (!project.domain) return undefined;

  const domain = project.domain.toLowerCase();
  if (domain.includes('preview privado') || domain.includes('private preview')) {
    return undefined;
  }
  if (project.domain.startsWith('http://') || project.domain.startsWith('https://')) {
    return project.domain;
  }
  return `https://${project.domain}`;
};

// Visual themes per project: gradient + icon + glow color
const themes = [
  {
    gradient: 'linear-gradient(135deg, #C8102E22 0%, #1D4ED822 100%)',
    icon: '🛒',
    accent: '#C8102E',
    glow: 'rgba(200, 16, 46, 0.25)',
    border: 'rgba(200, 16, 46, 0.35)',
  },
  {
    gradient: 'linear-gradient(135deg, #1D4ED822 0%, #00D4FF18 100%)',
    icon: '📊',
    accent: '#3B82F6',
    glow: 'rgba(59, 130, 246, 0.25)',
    border: 'rgba(59, 130, 246, 0.35)',
  },
  {
    gradient: 'linear-gradient(135deg, #F59E0B1A 0%, #C8102E18 100%)',
    icon: '📡',
    accent: '#F59E0B',
    glow: 'rgba(245, 158, 11, 0.25)',
    border: 'rgba(245, 158, 11, 0.35)',
  },
  {
    gradient: 'linear-gradient(135deg, #10B98118 0%, #1D4ED818 100%)',
    icon: '🤖',
    accent: '#10B981',
    glow: 'rgba(16, 185, 129, 0.25)',
    border: 'rgba(16, 185, 129, 0.35)',
  },
  {
    gradient: 'linear-gradient(135deg, #8B5CF618 0%, #C8102E18 100%)',
    icon: '⚙️',
    accent: '#8B5CF6',
    glow: 'rgba(139, 92, 246, 0.25)',
    border: 'rgba(139, 92, 246, 0.35)',
  },
  {
    gradient: 'linear-gradient(135deg, #1D4ED822 0%, #F59E0B1A 100%)',
    icon: '🏠',
    accent: '#3B82F6',
    glow: 'rgba(59, 130, 246, 0.25)',
    border: 'rgba(59, 130, 246, 0.35)',
  },
  {
    gradient: 'linear-gradient(135deg, #8B5CF622 0%, #1D4ED818 100%)',
    icon: '🧠',
    accent: '#8B5CF6',
    glow: 'rgba(139, 92, 246, 0.25)',
    border: 'rgba(139, 92, 246, 0.35)',
  },
  {
    gradient: 'linear-gradient(135deg, #10B98118 0%, #F59E0B1A 100%)',
    icon: '🚦',
    accent: '#10B981',
    glow: 'rgba(16, 185, 129, 0.25)',
    border: 'rgba(16, 185, 129, 0.35)',
  },
  {
    gradient: 'linear-gradient(135deg, #00D4FF18 0%, #1D4ED822 100%)',
    icon: '🎙️',
    accent: '#00A6C0',
    glow: 'rgba(0, 166, 192, 0.25)',
    border: 'rgba(0, 166, 192, 0.35)',
  },
  {
    gradient: 'linear-gradient(135deg, #25D36618 0%, #10B98118 100%)',
    icon: '💬',
    accent: '#25D366',
    glow: 'rgba(37, 211, 102, 0.25)',
    border: 'rgba(37, 211, 102, 0.35)',
  },
];

// Resolve gallery images per project (falls back to the single image)
const getGallery = (project: Project): string[] => {
  if (project.gallery && project.gallery.length > 0) return project.gallery;
  if (project.image) return [project.image];
  return [];
};

// Data serialized for the modal (populated client-side)
const projectsData = projects.map((proj, i) => ({
  title: proj.title,
  domain: proj.domain,
  description: proj.description,
  problem: proj.problem,
  solution: proj.solution,
  results: proj.results,
  tech: proj.tech.split(', '),
  accent: themes[i].accent,
  link: getProjectLink(proj) ?? null,
  gallery: getGallery(proj),
}));

const modalLabels = {
  close: lang === 'es' ? 'Cerrar' : 'Close',
  problem: lang === 'es' ? 'Problema' : 'Problem',
  solution: lang === 'es' ? 'Solución' : 'Solution',
  result: lang === 'es' ? 'Resultado' : 'Result',
  visit: p.visit,
  screenshot: lang === 'es' ? 'Captura' : 'Screenshot',
  private: lang === 'es' ? 'Preview privado' : 'Private preview',
};
---

<section class="section" id="projects">
  <div class="container">
    <div class="section-title-wrapper reveal">
      <h2 class="section-title">{p.title}</h2>
      <p class="section-subtitle">
        {lang === 'es'
          ? 'Proyectos reales, impacto medible. Cada uno resolvió un problema concreto.'
          : 'Real projects, measurable impact. Each one solved a concrete problem.'}
      </p>
    </div>

    <div class="projects-grid">
      {projects.map((proj, i) => {
        const projectLink = getProjectLink(proj);
        return (
          <article
            class="project-card"
            style={`--card-accent: ${themes[i].accent}; --card-glow: ${themes[i].glow}; --card-border: ${themes[i].border};`}
          >
          <!-- Card header: domain badge -->
          <div class="card-header">
            <div class="domain-badge">
              <span class="domain-dot"></span>
              <span class="domain-text">{proj.domain}</span>
            </div>
            <div class="card-number">{String(i + 1).padStart(2, '0')}</div>
          </div>

          <!-- Visual area (click to open gallery) -->
          {(() => { const gallery = getGallery(proj); return (
          <button
            class="card-visual"
            type="button"
            data-project-open={i}
            style={`background: ${themes[i].gradient}`}
            aria-label={`${lang === 'es' ? 'Ver galería de' : 'View gallery of'} ${proj.title}`}
          >
            {proj.image && (
              <>
                <img
                  class="card-shot"
                  src={proj.image}
                  alt={`${lang === 'es' ? 'Pantallazo de' : 'Screenshot of'} ${proj.title}`}
                  loading="lazy"
                  decoding="async"
                />
                <div class="card-shot-overlay" aria-hidden="true"></div>
              </>
            )}
            <span class="card-icon" aria-hidden="true">{themes[i].icon}</span>
            <div class="card-visual-lines" aria-hidden="true">
              <div class="vl vl-1"></div>
              <div class="vl vl-2"></div>
              <div class="vl vl-3"></div>
            </div>
            <span class="card-visual-hint" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              {lang === 'es' ? 'Ver galería' : 'View gallery'}
              {gallery.length > 1 && <span class="hint-count">{gallery.length}</span>}
            </span>
          </button>
          ); })()}

          <!-- Content -->
          <div class="card-content">
            <h3 class="card-title">{proj.title}</h3>
            <p class="card-desc">{proj.description}</p>

            <!-- Key result - prominently highlighted -->
            <div class="card-result">
              <span class="result-label">
                {lang === 'es' ? 'Resultado' : 'Result'}
              </span>
              <p class="result-text">{proj.results}</p>
            </div>

            <!-- Tech stack chips -->
            <div class="card-tech">
              {proj.tech.split(', ').map((t: string) => (
                <span class="tech-chip">{t}</span>
              ))}
            </div>
          </div>

          <!-- Details trigger (opens modal with gallery) -->
          <button class="card-details-btn" type="button" data-project-open={i}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
            {lang === 'es' ? 'Ver más detalles' : 'View more details'}
            <svg class="details-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </button>

          <!-- CTA button -->
          <div class="card-footer">
            {projectLink ? (
              <a
                href={projectLink}
                target="_blank"
                rel="noopener noreferrer"
                class="card-cta"
                aria-label={`${lang === 'es' ? 'Ver proyecto' : 'View project'}: ${proj.title}`}
              >
                <span class="cta-text">{p.visit}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/>
                  <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
              </a>
            ) : (
              <button class="card-cta card-cta--disabled" type="button" disabled>
                {lang === 'es' ? 'Preview privado' : 'Private preview'}
              </button>
            )}
          </div>
          </article>
        );
      })}
    </div>
  </div>

  <!-- ===== PROJECT MODAL ===== -->
  <div class="project-modal" id="projectModal" role="dialog" aria-modal="true" aria-hidden="true" aria-label={p.title}>
    <div class="modal-backdrop" data-close></div>
    <div class="modal-panel" role="document">
      <button class="modal-close" type="button" data-close aria-label={modalLabels.close}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      <!-- Gallery slider -->
      <div class="modal-gallery">
        <div class="gallery-viewport">
          <div class="gallery-track"></div>
        </div>
        <button class="gallery-nav gallery-prev" type="button" aria-label={lang === 'es' ? 'Anterior' : 'Previous'}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
        <button class="gallery-nav gallery-next" type="button" aria-label={lang === 'es' ? 'Siguiente' : 'Next'}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
        <div class="gallery-counter">1 / 1</div>
        <div class="gallery-dots"></div>
      </div>

      <!-- Info -->
      <div class="modal-body">
        <div class="modal-domain">
          <span class="modal-domain-dot"></span>
          <span class="modal-domain-text"></span>
        </div>
        <h3 class="modal-title"></h3>
        <p class="modal-desc"></p>

        <div class="modal-result">
          <span class="result-label">{modalLabels.result}</span>
          <p class="result-text modal-result-text"></p>
        </div>

        <div class="modal-detail">
          <span class="detail-label">⚠ {modalLabels.problem}</span>
          <p class="modal-problem-text"></p>
        </div>
        <div class="modal-detail">
          <span class="detail-label">💡 {modalLabels.solution}</span>
          <p class="modal-solution-text"></p>
        </div>

        <div class="modal-tech"></div>

        <a class="modal-cta" href="#" target="_blank" rel="noopener noreferrer">
          <span>{modalLabels.visit}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* === GRID LAYOUT === */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 8px;
  }

  /* === CARD BASE === */
  .project-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    border: 1px solid var(--card-border);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .project-card:hover {
    transform: translateY(-6px);
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.5),
      0 0 30px var(--card-glow);
    border-color: var(--card-border);
  }

  .project-card:hover::before {
    opacity: 1;
  }

  /* === CARD HEADER === */
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }

  .domain-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    overflow: hidden;
    min-width: 0;
  }

  .domain-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--card-accent);
    flex-shrink: 0;
    animation: domainPulse 2s ease-in-out infinite;
  }

  @keyframes domainPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .domain-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .project-card:hover .domain-text {
    color: var(--card-accent);
  }

  .card-number {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    flex-shrink: 0;
    margin-left: 8px;
  }

  /* === CARD VISUAL === */
  .card-visual {
    position: relative;
    height: 110px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
    color: #fff;
    -webkit-tap-highlight-color: transparent;
  }

  /* Hover hint over the visual */
  .card-visual-hint {
    position: absolute;
    z-index: 3;
    bottom: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    background: rgba(7, 7, 15, 0.72);
    backdrop-filter: blur(6px);
    border: 1px solid var(--card-border);
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .project-card:hover .card-visual-hint,
  .card-visual:focus-visible .card-visual-hint {
    opacity: 1;
    transform: translateY(0);
  }

  .card-visual-hint svg {
    color: var(--card-accent);
  }

  .hint-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    background: var(--card-accent);
    color: #fff;
    border-radius: 8px;
    font-size: 0.62rem;
    font-weight: 700;
  }

  .card-shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transform: scale(1.02);
    transition: transform 0.4s ease;
  }

  .card-shot-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 10, 0.05) 0%,
      rgba(10, 10, 10, 0.45) 100%
    );
  }

  .project-card:hover .card-shot {
    transform: scale(1.08);
  }

  .card-icon {
    font-size: 2.8rem;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 0 16px var(--card-glow));
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .project-card:hover .card-icon {
    transform: scale(1.15) rotate(-5deg);
  }

  /* Decorative lines on visual */
  .card-visual-lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .vl {
    position: absolute;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 1px;
    transition: opacity 0.4s ease;
  }

  .project-card:hover .vl {
    opacity: 0;
  }

  .vl-1 {
    width: 1px;
    height: 100%;
    left: 30%;
  }

  .vl-2 {
    width: 100%;
    height: 1px;
    top: 50%;
  }

  .vl-3 {
    width: 1px;
    height: 100%;
    right: 30%;
  }

  /* === CARD CONTENT === */
  .card-content {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    line-height: 1.1;
    transition: color 0.3s ease;
  }

  .project-card:hover .card-title {
    color: var(--card-accent);
  }

  .card-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.65;
    flex: 1;
  }

  /* === RESULT HIGHLIGHT === */
  .card-result {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-left: 3px solid var(--card-accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 10px 14px;
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .project-card:hover .card-result {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--card-border);
    border-left-color: var(--card-accent);
  }

  .result-label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: block;
    margin-bottom: 4px;
  }

  .result-text {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }

  /* === TECH CHIPS === */
  .card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tech-chip {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 3px 9px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text-secondary);
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .project-card:hover .tech-chip {
    border-color: var(--card-border);
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.06);
  }

  /* === DETAILS TRIGGER BUTTON === */
  .card-details-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 11px 20px;
    border: none;
    border-top: 1px solid var(--border);
    background: none;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.3s ease, background 0.3s ease;
  }

  .card-details-btn svg {
    flex-shrink: 0;
  }

  .details-arrow {
    margin-left: auto;
    transition: transform 0.3s ease;
  }

  .card-details-btn:hover {
    color: var(--card-accent);
    background: rgba(255, 255, 255, 0.02);
  }

  .card-details-btn:hover .details-arrow {
    transform: translateX(4px);
  }

  .detail-label {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* === CTA BUTTON === */
  .card-footer {
    padding: 14px 20px;
    border-top: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.01);
  }

  .card-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 11px 20px;
    background: var(--card-accent);
    color: #fff;
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .card-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.1);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px var(--card-glow);
  }

  .card-cta:hover::before {
    opacity: 1;
  }

  .card-cta svg {
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .card-cta:hover svg {
    transform: translate(2px, -2px);
  }

  .card-cta--disabled {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    border: 1px dashed var(--border);
    cursor: not-allowed;
    box-shadow: none;
    letter-spacing: 0.08em;
  }

  .card-cta--disabled:hover {
    transform: none;
    box-shadow: none;
  }

  /* === RESPONSIVE === */
  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .card-visual {
      height: 90px;
    }

    .card-content {
      padding: 16px;
    }

    .card-footer {
      padding: 12px 16px;
    }
