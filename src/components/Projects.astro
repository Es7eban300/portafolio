</style>

<!-- Modal styles are global so JS-created slides/chips are styled too -->
<style is:global>
  .project-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    --modal-accent: #3B82F6;
  }

  .project-modal.is-open {
    opacity: 1;
    visibility: visible;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 4, 10, 0.82);
    backdrop-filter: blur(8px);
  }

  .modal-panel {
    position: relative;
    width: 100%;
    max-width: 720px;
    max-height: 90vh;
    overflow-y: auto;
    background: var(--bg-card);
    border: 1px solid var(--border-hover);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.6), 0 0 40px rgba(0, 0, 0, 0.4);
    transform: translateY(24px) scale(0.98);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    scrollbar-width: thin;
  }

  .project-modal.is-open .modal-panel {
    transform: translateY(0) scale(1);
  }

  .modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: rgba(7, 7, 15, 0.7);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border-hover);
    border-radius: 50%;
    color: var(--text-primary);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .modal-close:hover {
    background: var(--crimson);
    border-color: var(--crimson);
    transform: rotate(90deg);
  }

  /* === GALLERY === */
  .modal-gallery {
    position: relative;
    background: #050510;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    overflow: hidden;
  }

  .gallery-viewport {
    overflow: hidden;
  }

  .gallery-track {
    display: flex;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .gallery-slide {
    flex: 0 0 100%;
    min-width: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #05050f;
    overflow: hidden;
    cursor: zoom-in;
  }

  .gallery-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transform: scale(1);
    transform-origin: center center;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  /* Cursor-following magnifier: zoom toward the pointer so small
     screenshots become legible on hover. */
  .gallery-slide.is-zooming {
    cursor: zoom-out;
  }

  .gallery-slide.is-zooming img {
    transform: scale(2.2);
    transition: transform 0.12s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-slide img { transition: none; }
  }

  /* Touch devices: no hover, so keep images at natural fit. */
  @media (hover: none) {
    .gallery-slide { cursor: default; }
    .gallery-slide.is-zooming img { transform: scale(1); }
  }

  .gallery-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(7, 7, 15, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border-hover);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .gallery-nav:hover {
    background: var(--modal-accent);
    border-color: var(--modal-accent);
  }

  .gallery-prev { left: 12px; }
  .gallery-next { right: 12px; }

  .gallery-counter {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    background: rgba(7, 7, 15, 0.7);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border-hover);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-primary);
  }

  .gallery-dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 7px;
  }

  .gallery-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .gallery-dot.is-active {
    background: var(--modal-accent);
    transform: scale(1.3);
  }

  /* Hide controls when a single image */
  .modal-gallery.is-single .gallery-nav,
  .modal-gallery.is-single .gallery-dots,
  .modal-gallery.is-single .gallery-counter {
    display: none;
  }

  /* === MODAL BODY === */
  .modal-body {
    padding: 26px 28px 30px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .modal-domain {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .modal-domain-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--modal-accent);
  }

  .modal-title {
    font-family: var(--font-display);
    font-size: 2rem;
    letter-spacing: 0.03em;
    line-height: 1.05;
    color: var(--text-primary);
  }

  .modal-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .modal-result {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-left: 3px solid var(--modal-accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 12px 16px;
  }

  .modal-result .result-label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: block;
    margin-bottom: 5px;
  }

  .modal-result .result-text {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .modal-detail {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .modal-detail .detail-label {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .modal-detail p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .modal-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 2px;
  }

  .modal-tech .tech-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .modal-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    align-self: flex-start;
    margin-top: 6px;
    padding: 12px 24px;
    background: var(--modal-accent);
    color: #fff;
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }

  .modal-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 640px) {
    .project-modal { padding: 12px; }
    .modal-panel { max-height: 94vh; }
    .modal-body { padding: 20px 18px 24px; }
    .modal-title { font-size: 1.6rem; }
    .gallery-nav { width: 34px; height: 34px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-track,
    .modal-panel,
    .project-modal { transition: none; }
  }
</style>

<script define:vars={{ projectsData, modalLabels }}>
  (function () {
    const modal = document.getElementById('projectModal');
    if (!modal) return;

    const track = modal.querySelector('.gallery-track');
    const dotsWrap = modal.querySelector('.gallery-dots');
    const counter = modal.querySelector('.gallery-counter');
    const galleryEl = modal.querySelector('.modal-gallery');
    const prevBtn = modal.querySelector('.gallery-prev');
    const nextBtn = modal.querySelector('.gallery-next');

    let current = 0;
    let slidesCount = 0;
    let lastFocused = null;

    function goTo(idx) {
      if (slidesCount === 0) return;
      current = (idx + slidesCount) % slidesCount;
      track.style.transform = 'translateX(' + (-current * 100) + '%)';
      counter.textContent = (current + 1) + ' / ' + slidesCount;
      dotsWrap.querySelectorAll('.gallery-dot').forEach(function (d, i) {
        d.classList.toggle('is-active', i === current);
      });
    }

    // Cursor-following magnifier: the pointer position sets the image's
    // transform-origin so hovering zooms toward whatever is under the cursor.
    function attachZoom(slide, img) {
      function move(e) {
        const rect = slide.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        img.style.transformOrigin =
          Math.max(0, Math.min(100, x)) + '% ' + Math.max(0, Math.min(100, y)) + '%';
      }
      slide.addEventListener('mouseenter', function (e) {
        slide.classList.add('is-zooming');
        move(e);
      });
      slide.addEventListener('mousemove', move);
      slide.addEventListener('mouseleave', function () {
        slide.classList.remove('is-zooming');
        img.style.transformOrigin = 'center center';
      });
    }

    function renderGallery(images, title) {
      track.innerHTML = '';
      dotsWrap.innerHTML = '';
      slidesCount = images.length;

      images.forEach(function (src, idx) {
        const slide = document.createElement('div');
        slide.className = 'gallery-slide';
        const img = document.createElement('img');
        img.src = src;
        img.alt = title + ' — ' + modalLabels.screenshot + ' ' + (idx + 1);
        img.loading = 'lazy';
        img.decoding = 'async';
        slide.appendChild(img);
        attachZoom(slide, img);
        track.appendChild(slide);

        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'gallery-dot';
        dot.setAttribute('aria-label', modalLabels.screenshot + ' ' + (idx + 1));
        dot.addEventListener('click', function () { goTo(idx); });
        dotsWrap.appendChild(dot);
      });

      galleryEl.classList.toggle('is-single', slidesCount <= 1);
      current = 0;
      track.style.transition = 'none';
      goTo(0);
      // Restore transition on next frame
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { track.style.transition = ''; });
      });
    }

    function openModal(index) {
      const data = projectsData[index];
      if (!data) return;
      lastFocused = document.activeElement;

      modal.style.setProperty('--modal-accent', data.accent);
      modal.querySelector('.modal-domain-text').textContent = data.domain;
      modal.querySelector('.modal-title').textContent = data.title;
      modal.querySelector('.modal-desc').textContent = data.description;
      modal.querySelector('.modal-result-text').textContent = data.results;
      modal.querySelector('.modal-problem-text').textContent = data.problem;
      modal.querySelector('.modal-solution-text').textContent = data.solution;

      const techWrap = modal.querySelector('.modal-tech');
      techWrap.innerHTML = '';
      data.tech.forEach(function (t) {
        const chip = document.createElement('span');
        chip.className = 'tech-chip';
        chip.textContent = t;
        techWrap.appendChild(chip);
      });

      const cta = modal.querySelector('.modal-cta');
      if (data.link) {
        cta.href = data.link;
        cta.style.display = '';
      } else {
        cta.style.display = 'none';
      }

      renderGallery(data.gallery, data.title);

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      modal.querySelector('.modal-close').focus();
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    document.querySelectorAll('[data-project-open]').forEach(function (el) {
      el.addEventListener('click', function () {
        openModal(parseInt(el.getAttribute('data-project-open'), 10));
      });
    });

    modal.querySelectorAll('[data-close]').forEach(function (el) {
      el.addEventListener('click', closeModal);
    });

    prevBtn.addEventListener('click', function () { goTo(current - 1); });
    nextBtn.addEventListener('click', function () { goTo(current + 1); });

    document.addEventListener('keydown', function (e) {
      if (!modal.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeModal();
      else if (e.key === 'ArrowLeft') goTo(current - 1);
      else if (e.key === 'ArrowRight') goTo(current + 1);
    });

    // Touch swipe
    let startX = 0;
    let swiping = false;
    track.addEventListener('touchstart', function (e) {
      startX = e.touches[0].clientX;
      swiping = true;
    }, { passive: true });
    track.addEventListener('touchend', function (e) {
      if (!swiping) return;
      swiping = false;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) goTo(current + (dx < 0 ? 1 : -1));
    }, { passive: true });
  })();
</script>
